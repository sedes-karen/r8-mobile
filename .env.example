# Ya viene un .env real committeado apuntando a Stage — no hace falta copiar este archivo para
# arrancar. Usalo solo si necesitás pisar algún valor para tu máquina (creá .env.local, gitignored).
EXPO_PUBLIC_API_URL=https://api.stage.r8.audio

# Opcional: en true, releasesApi (y a futuro cualquier módulo que lo respete) sirve datos mock
# locales en vez de pegarle a Stage. Por defecto es false (Stage real). Para activarlo localmente
# sin afectar a nadie más, ponelo en tu propio .env.local, no acá ni en el .env committeado.
# EXPO_PUBLIC_USE_MOCK=true
